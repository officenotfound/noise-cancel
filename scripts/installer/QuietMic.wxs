<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v5 package. Build: wix build scripts/installer/QuietMic.wxs -d Version=0.1.0 -d Src=dist/QuietMic -o dist/QuietMic-0.1.0-x64.msi
     Per-user install (no administrator needed). VB-Audio Virtual Cable is a separate, free driver (not bundled). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="QuietMic" Manufacturer="QuietMic" Version="$(Version)" UpgradeCode="6F0B2E0A-5A55-4C1B-9D2E-3C3E7B1A0002"
           Scope="perUser" InstallerVersion="500" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of QuietMic is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="PROGRAMSDIR" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="QuietMic" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Files Include="$(Src)\**" Directory="INSTALLFOLDER" />

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="6F0B2E0A-5A55-4C1B-9D2E-3C3E7B1A0003">
      <Shortcut Id="QuietMicShortcut" Name="QuietMic" Target="[INSTALLFOLDER]QuietMic.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\QuietMic" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="QuietMic" Level="1">
      <ComponentGroupRef Id="_Files" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
